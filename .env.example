MONGO_URI="YOUR MONGODB CONNECTION URI"
JWT_SECRET="YOUR JWT SECRET KEY"

# Public origin of this deployment, no trailing slash (e.g. https://orvella-demo.vercel.app)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# PayPal — "sandbox" (default) or "live". Use the client id / secret that belong to that environment.
PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="YOUR PAYPAL CLIENT ID"
PAYPAL_SECRET="YOUR PAYPAL SECRET"

# Random string; Vercel Cron sends it to /api/cron/* as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="A LONG RANDOM STRING"

# Email (resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Orvella <orders@your-domain.com>"
# Set to 1 to print emails to the server log when Resend is not configured
EMAIL_LOG=""

# Vercel Blob for photo uploads (created automatically when you add a Blob store to the project)
BLOB_READ_WRITE_TOKEN=""

NODE_ENV="development"

# NODE_ENV="production"
