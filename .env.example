MONGO_URI="YOUR MONGODB CONNECTION URI"
JWT_SECRET="YOUR JWT SECRET KEY"

# Public origin of this deployment, no trailing slash (e.g. https://orvella-demo.vercel.app)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# PayPal — "sandbox" (default) or "live". Use the client id / secret that belong to that environment.
PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="YOUR PAYPAL CLIENT ID"
PAYPAL_SECRET="YOUR PAYPAL SECRET"

# Random string; Vercel Cron sends it to /api/cron/* as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="A LONG RANDOM STRING"

NODE_ENV="development"

# NODE_ENV="production"
