# ==========================================
# Ignore everything in the project root
# ==========================================

/*


# ==========================================
# Website folders - INCLUDE
# ==========================================

!/app/
!/app/**

!/i18n/
!/i18n/**

!/demos/
!/demos/**

!/messages/
!/messages/**

!/public/
!/public/**

!/tests/
!/tests/**


# ==========================================
# Root configuration files - INCLUDE
# ==========================================

!/.browserslistrc
!/.env.example
!/.gitignore
!/.currency.ts
!/currency.ts
!/eslint.config.mjs
!/image_loader.ts
!/next.config.ts
!/package.json
!/package-lock.json
!/postcss.config.mjs
!/proxy.ts
!/tsconfig.json
!/vercel.json
!/vitest.config.mts


# ==========================================
# Exclude unwanted files and folders
# ==========================================

# Scripts
!/scripts/
!/scripts/**

# Local development files
/local*

# Development uploads
/public/dev-uploads/

# Environment variables
.env*

# Markdown files (EVERYWHERE)
*.md

# Batch files
*.bat

# Certificates
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript build cache
*.tsbuildinfo
/next-env.d.ts

# Operating system files
.DS_Store

# Build outputs and dependencies
/node_modules/
/.next/
/out/
/build/
/coverage/
/.vercel/
/.pnp
.pnp.*